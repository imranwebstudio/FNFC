// Office Catering Platform — Prisma schema (PostgreSQL / Neon)

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum PaymentMode {
  CASH
  WALLET
}

enum MealSlot {
  LUNCH
  DINNER
}

enum OrderStatus {
  PLACED
  CANCELLED
  DELIVERED
}

enum PaymentStatus {
  UNPAID
  PAID
  WALLET_CHARGED
}

enum WalletTxType {
  DEPOSIT
  CHARGE
  DUE_PAYMENT
  ADJUSTMENT
}

/// Bangladesh week starts Saturday
enum Weekday {
  SAT
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

model Account {
  id                       String  @id @default(cuid())
  userId                   String
  type                     String
  provider                 String
  providerAccountId        String
  refresh_token            String? @db.Text
  access_token             String? @db.Text
  expires_at               Int?
  token_type               String?
  scope                    String?
  id_token                 String? @db.Text
  session_state            String?
  refresh_token_expires_in Int?
  user                     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String?   @unique
  emailVerified   DateTime?
  image           String?
  role            Role      @default(USER)
  employeeId      String?
  phoneNumber     String?
  deskNumber      String?
  buildingNumber  String?
  floorNumber     String?
  locationId      String?
  paymentMode     PaymentMode @default(CASH)
  /// Balance in integer taka; may be negative (due)
  balance         Int       @default(0)
  profileComplete Boolean   @default(false)
  isBanned        Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  location            Location?           @relation(fields: [locationId], references: [id])
  accounts            Account[]
  sessions            Session[]
  adminLocations      AdminLocation[]
  orders              Order[]             @relation("OrdersOwned")
  ordersPlaced        Order[]             @relation("OrdersPlacedBy")
  walletTransactions  WalletTransaction[] @relation("WalletOwner")
  createdTransactions WalletTransaction[] @relation("WalletCreator")

  @@index([locationId])
  @@index([role])
}

model Location {
  id               String   @id @default(cuid())
  name             String
  address          String?
  /// Order cutoff as "HH:mm" in Asia/Dhaka (e.g. "14:00")
  defaultCutoffTime String  @default("14:00")
  /// When false, dinner menus are hidden from employees and admin meal UI
  dinnerEnabled    Boolean  @default(false)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users          User[]
  adminLocations AdminLocation[]
  dailyMenus     DailyMenu[]
  weekdayMenus   WeekdayMenu[]
  orders         Order[]
}

model AdminLocation {
  id         String @id @default(cuid())
  userId     String
  locationId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([userId, locationId])
}

model MealCatalog {
  id           String   @id @default(cuid())
  name         String
  description  String?
  imageUrl     String?
  defaultPrice Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  dailyMenus   DailyMenu[]
  weekdayMenus WeekdayMenu[]
}

/// Recurring meal option for a weekday at one office (many per weekday+slot)
model WeekdayMenu {
  id            String   @id @default(cuid())
  locationId    String
  weekday       Weekday
  slot          MealSlot
  title         String
  description   String?
  price         Int
  imageUrl      String?
  catalogItemId String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  location    Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  catalogItem MealCatalog? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  dailyMenus  DailyMenu[]

  @@index([locationId, weekday, slot])
  @@index([weekday, isActive])
}

model DailyMenu {
  id                  String   @id @default(cuid())
  locationId          String
  date                DateTime @db.Date
  slot                MealSlot
  title               String
  description         String?
  price               Int
  imageUrl            String?
  catalogItemId       String?
  /// When set, this row was materialized from a weekday template
  sourceWeekdayMenuId String?
  /// Absolute cutoff datetime (Asia/Dhaka resolved); null = use location default for that day
  cutoffAt            DateTime?
  isPublished         Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  location          Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)
  catalogItem       MealCatalog? @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  sourceWeekdayMenu WeekdayMenu? @relation(fields: [sourceWeekdayMenuId], references: [id], onDelete: SetNull)
  orders            Order[]

  @@unique([date, sourceWeekdayMenuId])
  @@index([locationId, date, slot])
  @@index([date, isPublished])
}

model Order {
  id            String        @id @default(cuid())
  userId        String
  dailyMenuId   String
  locationId    String
  /// Number of meals in this order (unit price × quantity = amount)
  quantity      Int           @default(1)
  amount        Int
  note          String?
  status        OrderStatus   @default(PLACED)
  paymentStatus PaymentStatus @default(UNPAID)
  deliveredAt   DateTime?
  paidAt        DateTime?
  /// Admin who placed this order on behalf of the user (null = self-order)
  placedById    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user       User                @relation("OrdersOwned", fields: [userId], references: [id], onDelete: Cascade)
  placedBy   User?               @relation("OrdersPlacedBy", fields: [placedById], references: [id], onDelete: SetNull)
  dailyMenu  DailyMenu           @relation(fields: [dailyMenuId], references: [id], onDelete: Cascade)
  location   Location            @relation(fields: [locationId], references: [id], onDelete: Cascade)
  walletTxs  WalletTransaction[]

  @@index([dailyMenuId, status])
  @@index([locationId, createdAt])
  @@index([userId, createdAt])
  @@index([placedById])
}

model WalletTransaction {
  id           String       @id @default(cuid())
  userId       String
  type         WalletTxType
  /// Signed amount applied to balance (positive deposit, negative charge)
  amount       Int
  balanceAfter Int
  orderId      String?
  createdById  String?
  note         String?
  createdAt    DateTime     @default(now())

  user      User   @relation("WalletOwner", fields: [userId], references: [id], onDelete: Cascade)
  order     Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdBy User?  @relation("WalletCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
